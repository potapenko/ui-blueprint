{
  "$defs": {
    "AnalysisArtifact": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "data": {
              "$ref": "#/$defs/GeometryQuery"
            },
            "kind": {
              "const": "geometry_query",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "data": {
              "$ref": "#/$defs/EvaluationInput"
            },
            "kind": {
              "const": "evaluation_input",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "data": {
              "$ref": "#/$defs/MeasurementCase"
            },
            "kind": {
              "const": "measurement",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "data": {
              "$ref": "#/$defs/GeometryCheckCase"
            },
            "kind": {
              "const": "geometry_check",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "type": "object"
        }
      ]
    },
    "AnalysisVersion": {
      "description": "Exact local analysis version. It does not participate in plugin negotiation.",
      "enum": [
        "0.2.0"
      ],
      "type": "string"
    },
    "Anchor": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "$ref": "#/$defs/Id"
        },
        "coordinate_space": {
          "$ref": "#/$defs/Space"
        },
        "element": {
          "$ref": "#/$defs/SourceKey"
        },
        "fraction": {
          "format": "double",
          "type": "number"
        },
        "frame_kind": {
          "$ref": "#/$defs/FrameKind"
        }
      },
      "required": [
        "element",
        "frame_kind",
        "coordinate_space",
        "fraction",
        "axis"
      ],
      "type": "object"
    },
    "AnswerSource": {
      "enum": [
        "live",
        "cache"
      ],
      "type": "string"
    },
    "Availability": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "availability": {
              "const": "known",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Value"
            }
          },
          "required": [
            "availability",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "availability": {
              "const": "unknown",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "availability",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "availability": {
              "const": "unsupported",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "availability",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "availability": {
              "const": "redacted",
              "type": "string"
            }
          },
          "required": [
            "availability"
          ],
          "type": "object"
        }
      ]
    },
    "CaptureFrame": {
      "additionalProperties": false,
      "properties": {
        "capture_kind": {
          "$ref": "#/$defs/CaptureKind"
        },
        "capture_target": {
          "$ref": "#/$defs/Identity"
        },
        "captures_audio": {
          "type": "boolean"
        },
        "crop_transform": {
          "$ref": "#/$defs/TransformState"
        },
        "excluded_surfaces": {
          "items": {
            "$ref": "#/$defs/Identity"
          },
          "type": "array"
        },
        "filter_id": {
          "$ref": "#/$defs/Id"
        },
        "included_surfaces": {
          "items": {
            "$ref": "#/$defs/Identity"
          },
          "type": "array"
        },
        "observation_id": {
          "$ref": "#/$defs/Id"
        },
        "payload_ref": {
          "$ref": "#/$defs/Id"
        },
        "pixel_height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pixel_width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "surface_coverage": {
          "$ref": "#/$defs/CoverageStatus"
        },
        "unresolved_surfaces": {
          "items": {
            "$ref": "#/$defs/Identity"
          },
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "capture_target",
        "capture_kind",
        "pixel_width",
        "pixel_height",
        "crop_transform",
        "included_surfaces",
        "excluded_surfaces",
        "unresolved_surfaces",
        "surface_coverage",
        "captures_audio",
        "filter_id",
        "payload_ref"
      ],
      "type": "object"
    },
    "CaptureKind": {
      "enum": [
        "window_isolated",
        "display_composited"
      ],
      "type": "string"
    },
    "Channel": {
      "enum": [
        "external_semantics",
        "rendered_capture",
        "opt_in_layout_probe"
      ],
      "type": "string"
    },
    "CheckStatus": {
      "enum": [
        "pass",
        "fail",
        "unknown"
      ],
      "type": "string"
    },
    "Comparison": {
      "enum": [
        "equal",
        "at_least",
        "at_most",
        "greater_than"
      ],
      "type": "string"
    },
    "ComponentMapping": {
      "additionalProperties": false,
      "properties": {
        "declaration_source": {
          "$ref": "#/$defs/Id"
        },
        "logical_component_key": {
          "$ref": "#/$defs/Id"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/SourceKey"
          },
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "logical_component_key",
        "members",
        "declaration_source",
        "provenance"
      ],
      "type": "object"
    },
    "Consistency": {
      "enum": [
        "stable",
        "unstable",
        "unknown"
      ],
      "type": "string"
    },
    "Context": {
      "additionalProperties": false,
      "properties": {
        "environment_revision": {
          "$ref": "#/$defs/Id"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/Field"
          },
          "type": "array"
        },
        "plugin": {
          "$ref": "#/$defs/PluginIdentity"
        },
        "projection": {
          "$ref": "#/$defs/Projection"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "scope_id": {
          "$ref": "#/$defs/Id"
        },
        "session_id": {
          "$ref": "#/$defs/Id"
        },
        "surfaces": {
          "items": {
            "$ref": "#/$defs/Identity"
          },
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "schema_version",
        "session_id",
        "target",
        "surfaces",
        "scope_id",
        "projection",
        "fields",
        "plugin",
        "environment_revision"
      ],
      "type": "object"
    },
    "ContextConditions": {
      "additionalProperties": false,
      "properties": {
        "input_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputModality"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "text_scale": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/Field"
          },
          "type": "array"
        },
        "omitted_count": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "scope_id": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "$ref": "#/$defs/CoverageStatus"
        },
        "unknown_count": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "scope_id",
        "fields"
      ],
      "type": "object"
    },
    "CoverageStatus": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "type": "string"
    },
    "EvaluationInput": {
      "additionalProperties": false,
      "description": "Owned inputs bound to one immutable source; observations are not invented here.",
      "properties": {
        "conditions": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservedConditions"
            },
            {
              "type": "null"
            }
          ]
        },
        "context": {
          "$ref": "#/$defs/Context"
        },
        "result_space": {
          "$ref": "#/$defs/Space"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "snapshot_id": {
          "$ref": "#/$defs/Id"
        },
        "transforms": {
          "items": {
            "$ref": "#/$defs/Transform"
          },
          "type": "array"
        }
      },
      "required": [
        "snapshot_id",
        "revision",
        "context",
        "result_space",
        "transforms"
      ],
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "$ref": "#/$defs/Id"
        },
        "observation_id": {
          "$ref": "#/$defs/Id"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "source_namespace": {
          "$ref": "#/$defs/Id"
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uncertainty"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "observation_id",
        "source_namespace",
        "provenance",
        "method"
      ],
      "type": "object"
    },
    "Expectation": {
      "additionalProperties": false,
      "properties": {
        "applies_when": {
          "$ref": "#/$defs/ContextConditions"
        },
        "expected_from": {
          "$ref": "#/$defs/Id"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "rule": {
          "$ref": "#/$defs/Rule"
        },
        "scope_id": {
          "$ref": "#/$defs/Id"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/SourceKey"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "scope_id",
        "targets",
        "rule",
        "applies_when",
        "expected_from"
      ],
      "type": "object"
    },
    "ExtensionProperty": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/Id"
        },
        "namespace": {
          "$ref": "#/$defs/Id"
        },
        "property": {
          "$ref": "#/$defs/Property"
        }
      },
      "required": [
        "namespace",
        "name",
        "property"
      ],
      "type": "object"
    },
    "Field": {
      "enum": [
        "role",
        "name",
        "accessibility_name",
        "visible_text",
        "description",
        "value",
        "placeholder",
        "input_kind",
        "required",
        "enabled",
        "readonly",
        "checked",
        "selected",
        "expanded",
        "focused",
        "invalid",
        "actions",
        "layout_bounds",
        "accessibility_bounds",
        "hit_region",
        "visible_region",
        "baseline",
        "paint_bounds"
      ],
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "expectation_id": {
          "$ref": "#/$defs/Id"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "measured": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_id": {
          "$ref": "#/$defs/Id"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        }
      },
      "required": [
        "id",
        "expectation_id",
        "snapshot_id",
        "status"
      ],
      "type": "object"
    },
    "Focus": {
      "additionalProperties": false,
      "properties": {
        "accessibility": {
          "$ref": "#/$defs/FocusRef"
        },
        "active_descendant": {
          "$ref": "#/$defs/FocusRef"
        },
        "composition_state": {
          "$ref": "#/$defs/Property"
        },
        "keyboard": {
          "$ref": "#/$defs/FocusRef"
        },
        "text_selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSelection"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "keyboard",
        "accessibility",
        "active_descendant",
        "composition_state"
      ],
      "type": "object"
    },
    "FocusRef": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "not_requested",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Evidence"
            },
            "status": {
              "const": "known",
              "type": "string"
            },
            "target": {
              "$ref": "#/$defs/SourceKey"
            }
          },
          "required": [
            "status",
            "target",
            "evidence"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "$ref": "#/$defs/Evidence"
            },
            "status": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "status",
            "evidence"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "$ref": "#/$defs/Id"
            },
            "status": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "FrameKind": {
      "enum": [
        "layout_bounds",
        "accessibility_bounds",
        "hit_region",
        "visible_region",
        "paint_bounds"
      ],
      "type": "string"
    },
    "Freshness": {
      "enum": [
        "current",
        "stale",
        "unverified"
      ],
      "type": "string"
    },
    "FreshnessBasis": {
      "enum": [
        "live_read",
        "revalidated",
        "ttl_only",
        "unverified"
      ],
      "type": "string"
    },
    "Geometry": {
      "additionalProperties": false,
      "properties": {
        "coordinate_space": {
          "$ref": "#/$defs/Space"
        },
        "frame_kind": {
          "$ref": "#/$defs/FrameKind"
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "transform": {
          "$ref": "#/$defs/TransformState"
        }
      },
      "required": [
        "frame_kind",
        "coordinate_space",
        "shape",
        "transform"
      ],
      "type": "object"
    },
    "GeometryCheckCase": {
      "additionalProperties": false,
      "properties": {
        "evaluation": {
          "$ref": "#/$defs/EvaluationInput"
        },
        "expectation": {
          "$ref": "#/$defs/Expectation"
        },
        "finding": {
          "$ref": "#/$defs/Finding"
        },
        "measurement": {
          "$ref": "#/$defs/MeasurementResult"
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        }
      },
      "required": [
        "snapshot",
        "expectation",
        "evaluation",
        "measurement",
        "finding"
      ],
      "type": "object"
    },
    "GeometryQuery": {
      "additionalProperties": false,
      "description": "Factual relation inputs, with no expected value/comparison/tolerance.",
      "properties": {
        "anchors": {
          "items": {
            "$ref": "#/$defs/Anchor"
          },
          "type": "array"
        },
        "applies_when": {
          "$ref": "#/$defs/ContextConditions"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "operation": {
          "$ref": "#/$defs/GeometryRelation"
        },
        "quantity_kind": {
          "$ref": "#/$defs/QuantityKind"
        },
        "scope_id": {
          "$ref": "#/$defs/Id"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/SourceKey"
          },
          "type": "array"
        },
        "units": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "id",
        "scope_id",
        "targets",
        "operation",
        "anchors",
        "quantity_kind",
        "units",
        "applies_when"
      ],
      "type": "object"
    },
    "GeometryRelation": {
      "enum": [
        "gap",
        "distance",
        "aligned",
        "inside",
        "intersects",
        "overflow",
        "width",
        "height",
        "ratio",
        "equal_spacing",
        "baseline"
      ],
      "type": "string"
    },
    "Id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "$ref": "#/$defs/Id"
        },
        "id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "id",
        "generation"
      ],
      "type": "object"
    },
    "InputModality": {
      "enum": [
        "semantic",
        "pointer",
        "keyboard",
        "setter",
        "touch",
        "remote"
      ],
      "type": "string"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "$ref": "#/$defs/MeasurementDetails"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "space": {
          "$ref": "#/$defs/Space"
        },
        "value": {
          "$ref": "#/$defs/Value"
        }
      },
      "required": [
        "value",
        "space",
        "details",
        "evidence"
      ],
      "type": "object"
    },
    "MeasurementCase": {
      "additionalProperties": false,
      "properties": {
        "evaluation": {
          "$ref": "#/$defs/EvaluationInput"
        },
        "query": {
          "$ref": "#/$defs/GeometryQuery"
        },
        "result": {
          "$ref": "#/$defs/MeasurementResult"
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        }
      },
      "required": [
        "snapshot",
        "query",
        "evaluation",
        "result"
      ],
      "type": "object"
    },
    "MeasurementDetails": {
      "description": "Rect details are in the selected result space; insets are not padding and\nintersection is not a claim about visual occlusion.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "scalar",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bottom": {
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "insets",
              "type": "string"
            },
            "left": {
              "format": "double",
              "type": "number"
            },
            "right": {
              "format": "double",
              "type": "number"
            },
            "top": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "left",
            "top",
            "right",
            "bottom"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "intersection",
              "type": "string"
            },
            "rect": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Rect"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "gaps",
              "type": "string"
            },
            "values": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "type": "object"
        }
      ]
    },
    "MeasurementResult": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "measurement": {
              "$ref": "#/$defs/Measurement"
            },
            "status": {
              "const": "known",
              "type": "string"
            }
          },
          "required": [
            "status",
            "measurement"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "evidence": {
              "items": {
                "$ref": "#/$defs/Evidence"
